# ============================================================================
# AdbControl backend 凭证模板。
# 用法:cp secrets.properties.template secrets.properties,然后填入占位符凭证。
# secrets.properties 不入 git(见 .gitignore)。
# 也可用同名环境变量覆盖(优先级 env > secrets.properties > 已知默认值)。
# 环境变量命名:全部大写 + ADB_ 前缀,如 ADB_EMQX_APP_SECRET、ADB_DB_PASSWORD。
# 解析逻辑见 backend/src/main/kotlin/com/adbcontrol/backend/config/BackendConfig.kt
# ============================================================================

# 后端自身对外 URL(用于生成 QR 码)。生产改成你的域名。
server.url = https://api.adbcontrol.example.com

# ---- EMQX Cloud Serverless(已知值已预填,app_secret 需从 EMQX 控制台取) ----
emqx.host = o8cc1111.ala.cn-hangzhou.emqxsl.cn
emqx.port = 8883
emqx.appid = o8cc1111
emqx.rest_endpoint = https://o8cc1111.ala.cn-hangzhou.emqxsl.cn:8443
# 占位符:在 EMQX 控制台 Application 模块创建后填入 app_secret
emqx.app_secret = REPLACE_ME_EMQX_APP_SECRET

# ---- Cloudflare R2(已知值已预填,密钥需从 Cloudflare 控制台取) ----
r2.endpoint = https://696e933486bc331658bce6378aaceaea.r2.cloudflarestorage.com
r2.bucket = slss-boby
# 占位符:Cloudflare R2 API Token 的 AccessKey / AccessSecret
r2.access_key = REPLACE_ME_R2_ACCESS_KEY
r2.access_secret = REPLACE_ME_R2_ACCESS_SECRET

# ---- MySQL(已知值已预填) ----
db.host = mysql6.sqlpub.com
db.port = 3311
db.name = slss12
db.user = slss12
db.password = kYxWgH8ySV0tGiqN
