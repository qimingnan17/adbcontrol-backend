# ============================================================================
# AdbControl backend 凭证模板。
# 用法:cp secrets.properties.template secrets.properties,然后填入占位符凭证。
# secrets.properties 不入 git(见 .gitignore)。
# 也可用同名环境变量覆盖(优先级 env > secrets.properties > 已知默认值)。
# 环境变量命名:全部大写 + ADB_ 前缀,如 ADB_EMQX_APP_SECRET、ADB_DB_PASSWORD。
# 解析逻辑见 backend/src/main/kotlin/com/adbcontrol/backend/config/BackendConfig.kt
# ============================================================================

# 后端自身对外 URL(用于生成 QR 码)。生产改成你的域名。
server.url = https://api.adbcontrol.example.com

# ---- EMQX Cloud Serverless(已知值已预填,app_secret 需从 EMQX 控制台取) ----
emqx.host = o8cc1111.ala.cn-hangzhou.emqxsl.cn
emqx.port = 8883
emqx.appid = o8cc1111
# REST API 根地址(EMQX 5.x 带 /api/v5)
emqx.rest_endpoint = https://o8cc1111.ala.cn-hangzhou.emqxsl.cn:8443/api/v5
# 占位符:在 EMQX 控制台 API Key 管理模块创建后填入
emqx.app_secret = REPLACE_ME_EMQX_APP_SECRET
# publish 路径(相对 rest_endpoint)。EMQX 5.x=/publish,旧版 4.x=/mqtt/v1/publish
emqx.publish_path = /publish

# ---- 设备侧 MQTT 传输(自部署 EMQX + Cloudflare Tunnel 场景) ----
# 默认 false = 裸 TCP TLS(EMQX Cloud / IPv6 直连)。隧道只转发 HTTP(S)/WebSocket,
# 裸 TCP MQTT 无法过 CF,自部署走隧道时置 true,设备改用 wss:// 连接。
# 环境变量:ADB_EMQX_BROKER_WS / ADB_EMQX_BROKER_WS_PORT / ADB_EMQX_BROKER_WS_PATH
# emqx.broker_ws = false
# useWs=true 时设备连接的 WS 端口(经 CF 隧道填 443,IPv6 直连 WS 填 8083/8084)
# emqx.broker_ws_port = 8084
# WS 路径,EMQX 默认 /mqtt
# emqx.broker_ws_path = /mqtt

# ---- Cloudflare R2(已知值已预填,密钥需从 Cloudflare 控制台取) ----
r2.endpoint = https://696e933486bc331658bce6378aaceaea.r2.cloudflarestorage.com
r2.bucket = slss-boby
# 占位符:Cloudflare R2 API Token 的 AccessKey / AccessSecret
r2.access_key = REPLACE_ME_R2_ACCESS_KEY
r2.access_secret = REPLACE_ME_R2_ACCESS_SECRET

# ---- MySQL(已知值已预填) ----
db.host = mysql6.sqlpub.com
db.port = 3311
db.name = slss12
db.user = slss12
# 占位符:SQLPub 控制台查看;旧密码曾进入 git 历史,已视为泄露,请先在 SQLPub 重置后再填
db.password = REPLACE_ME_DB_PASSWORD

# ---- 遥测 ingestor(可选;缺省则后端不落遥测,其余功能不受影响) ----
# 操作:EMQX 控制台手工创建一个专用账号(建议用户名 ingestor),并授予
# status/+ health/+ location/+ activity/+ usage/+ result/+ device/offline/+ 的订阅 ACL。
# 代码不会自注册该账号。
emqx.ingest_username = REPLACE_ME_INGEST_MQTT_USERNAME
emqx.ingest_password = REPLACE_ME_INGEST_MQTT_PASSWORD

# ---- Cloudflare OAuth 一键授权（推荐，替代手工粘贴 API Token） ----
# 在 Cloudflare 控制台 → Manage Account → OAuth clients 创建（私有 client 即可），
# Redirect URL 填 <server.url>/api/admin/settings/cloudflare/oauth/callback。
# 以下四项通常无需手写：在 Web「系统设置 → 隧道与域名 → 高级 → Cloudflare 一键授权」
# 点一次「连接 Cloudflare」后由后端自动写入并自动续期 refresh_token。
# cf.oauth_client_id = REPLACE_ME_CF_OAUTH_CLIENT_ID
# cf.oauth_client_secret = REPLACE_ME_CF_OAUTH_CLIENT_SECRET
# 可选：覆盖默认授权 scope（空格分隔）。
# cf.oauth_scopes = offline_access

# ---- R2 公开访问基地址（可选，通常由一键配置自动写入） ----
# 如 r2.dev 域名 https://pub-xxxx.r2.dev。为空时被控端回退用 S3 endpoint 拼 URL。
# 对应环境变量 ADB_R2_PUBLIC_BASE_URL。
# r2.public_base_url = https://pub-xxxxxxxx.r2.dev

# ---- R2 全自动配置用的 bootstrap token（可选，也可由 Web 设置页写入） ----
# ⚠️ 高危凭据:需具备「Account API Tokens:Edit」,可签发账户下任意 API Token,
# 比 OAuth 票据敏感得多。仅用于一次性生成 R2 的桶级 S3 凭据。
# 不填也能用:不填时每次一键配置 R2 都需要在页面上临时粘贴一次。
# cf.bootstrap_token = REPLACE_ME_CF_BOOTSTRAP_TOKEN

# ---- 文件中转存储目录（可选） ----
# 手机 ↔ 后端 ↔ Web 的文件中转落盘位置。缺省：Windows 为 C:\adbcontrol\files，
# 其它平台为 ./data/files。对应环境变量 ADB_FILES_DIR。
# 注意：这是暂存/中转目录，需要长期归档请另行挂载对象存储迁移任务。
